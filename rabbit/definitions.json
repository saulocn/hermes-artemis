{
  "rabbit_version": "4.0.0",
  "rabbitmq_version": "4.0.0",
  "product_name": "RabbitMQ",
  "product_version": "4.0.0",
  "users": [
    {
      "name": "hermes",
      "password": "pass_hermes",
      "tags": ["administrator"]
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "hermes",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [],
  "policies": [],
  "queues": [
    {
      "name": "MailQueue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 10,
        "x-dead-letter-exchange": "hermes.dlx"
      }
    },
    {
      "name": "MailQueueDLQ",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "exchanges": [
    {
      "name": "hermes.dlx",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "hermes.dlx",
      "vhost": "/",
      "destination": "MailQueueDLQ",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
}
